{
  "functions": [
    {
      "source": "functions",
      "codebase": "saju-unse",
      "runtime": "nodejs20"
    }
  ],
  "hosting": {
    "target": "sajuunse",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/login",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/signup",
        "destination": "/",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "sajuApi",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "postdeploy": [
      "node ../scripts/sync-hub.mjs"
    ]
  }
}
