# 공개용 식별자만 넣습니다. 시크릿(Toss secret, Kakao client secret)은
# firebase functions:secrets:set 으로만 등록하세요. 이 파일은 커밋해도 됩니다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vaulted-acolyte-387217.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vaulted-acolyte-387217
VITE_FIREBASE_STORAGE_BUCKET=vaulted-acolyte-387217.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Toss Payments 클라이언트 키 (test_ck_ … / live_ck_ …)
VITE_TOSS_CLIENT_KEY=

# Kakao REST API 키 (리다이렉트 OAuth). Redirect URI:
#   http://localhost:5173/auth/kakao/callback
#   https://jeonyoungjae-saju-unse.web.app/auth/kakao/callback
VITE_KAKAO_REST_API_KEY=

# Naver Client ID. Callback URL:
#   http://localhost:5173/auth/naver/callback
#   https://jeonyoungjae-saju-unse.web.app/auth/naver/callback
VITE_NAVER_CLIENT_ID=
